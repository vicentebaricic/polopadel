{# Base común: <head>, encabezado, menú móvil, pie y scripts. Las páginas llenan el bloque "main". #}
{% import "macros.j2" as m with context %}
<!doctype html>
<html lang="es-CL"{% if E.selector_propuestas or E.propuesta_inicial == "marca" %} data-palette="{{ E.propuesta_inicial }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ club.seo.titulo }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ club.seo.descripcion }}{% endblock %}">
<meta name="theme-color" content="{{ club.paleta.marca }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ club.seo.titulo }}">
<meta property="og:description" content="{{ club.seo.descripcion }}">
{% if club.seo.imagen %}<meta property="og:image" content="{{ club.seo.imagen }}">
{% endif %}
<link rel="icon" href="{{ club.marca.favicon }}" type="image/png">
<link rel="apple-touch-icon" href="{{ club.marca.apple_icon }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ tipo.url }}" rel="stylesheet">
<style>
{% include "styles.css.j2" %}
</style>
</head>
<body class="no-js">
<a class="skip" href="#main">Saltar al contenido</a>

<!-- =========================================================
     HEADER
     ========================================================= -->
<header class="header{% if page == 'index' and E.hero == 'completo' %} is-over{% endif %}">
  <div class="wrap header__in">
    <a class="brand" href="{{ '#top' if page == 'index' else 'index.html' }}" aria-label="{{ club.nombre }}, ir al inicio">
      <span class="brand__logo"></span>
    </a>
    <nav class="nav" aria-label="Principal">
      <ul>
{% for s in E.menu %}
        <li><a href="{{ m.href(s) }}"{% if page == s %} aria-current="page"{% endif %}>{{ T.menu[s] }}</a></li>
{% endfor %}
      </ul>
    </nav>
    <div class="header__actions">
      <button class="icon-btn theme-toggle" type="button" aria-label="{{ T.botones.modo }}">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn--ghost header__book js-book" href="#">{{ T.botones.reservar }}</a>
      <a class="btn btn--solid js-wa" data-wa="header" href="#">{{ T.botones.socio }}</a>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer">
  <ul>
{% for s in E.menu %}
    <li><a href="{{ m.href(s) }}">{{ T.menu.visita_largo if s == "visita" else T.menu[s] }} <span>{{ "$" if s == "precios" else num.get(s, "") }}</span></a></li>
{% endfor %}
  </ul>
  <a class="btn btn--solid js-wa" data-wa="menu" href="#">{{ m.wa_icon() }}{{ T.botones.socio }}</a>
  <a class="btn btn--ghost js-book" href="#">{{ T.botones.reservar }} en {{ club.contacto.reservas.nombre }}</a>
</div>

{% block main %}{% endblock %}

<!-- =========================================================
     FOOTER
     ========================================================= -->
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a class="brand" href="{{ '#top' if page == 'index' else 'index.html' }}" aria-label="{{ club.nombre }}, ir al inicio">
          <span class="brand__logo"></span>
        </a>
        <p class="footer__tag">{{ T.footer.lema }}</p>
      </div>
      <div>
        <h4>{{ T.footer.club }}</h4>
        <ul>
{% for s in ["club", "metodo", "precios", "equipo", "visita"] if (s in secciones or s == "precios") and (s != "precios" or club.precios) %}
          <li><a href="{{ m.href(s) }}">{{ T.menu[s] }}</a></li>
{% endfor %}
        </ul>
      </div>
      <div>
        <h4>{{ T.footer.contacto }}</h4>
        <ul>
          <li><a class="js-wa" data-wa="footer" href="#">{{ m.wa_icon() }}<span data-wa-label></span></a></li>
          <li><a class="js-book" href="#">{{ T.footer.reservas }} en {{ club.contacto.reservas.nombre }}</a></li>
          <li><a href="https://www.google.com/maps/dir/?api=1&destination={{ club.ubicacion.mapa | urlencode }}" target="_blank" rel="noopener">{{ club.ubicacion.direccion_corta }}</a></li>
        </ul>
      </div>
      <div>
        <h4>{{ T.footer.siguenos }}</h4>
        <ul>
          <li><a class="js-ig" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>Instagram</a></li>
          <li><a class="js-fb" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21h3Z"/></svg>Facebook</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__base">
      <span>© <span id="year"></span> {{ club.nombre }} · {{ club.ubicacion.zona }}</span>
      <span>{{ club.ubicacion.direccion_completa }}</span>
    </div>
  </div>
</footer>

<a class="wa-float js-wa" data-wa="flotante" href="#" aria-label="Escribir a {{ club.nombre }} por WhatsApp">
  {{ m.wa_icon() }}
</a>
{% if E.selector_propuestas %}

<!-- Selector de propuesta de color: solo para revisar con el cliente, quitar antes de publicar (estilo.selector_propuestas: false) -->
<div class="palette-switch" role="group" aria-label="Propuesta de color">
  <span>Propuesta</span>
  <button type="button" data-palette="marca" aria-pressed="{{ 'true' if E.propuesta_inicial == 'marca' else 'false' }}">{{ E.nombres_propuestas.marca }}</button>
  <button type="button" data-palette="clara" aria-pressed="{{ 'true' if E.propuesta_inicial == 'clara' else 'false' }}">{{ E.nombres_propuestas.clara }}</button>
</div>
{% endif %}

<!-- Íconos -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-wa" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 4.54 0 8.23 3.7 8.23 8.24 0 4.54-3.69 8.24-8.23 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.7l5.9-.9z"/></symbol>
</svg>

<script>
{% include "scripts.js.j2" %}
</script>
</body>
</html>
