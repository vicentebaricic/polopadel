{% extends "base.html.j2" %}
{% import "macros.j2" as m with context %}
{% block title %}Precios · {{ club.seo.titulo }}{% endblock %}
{% block description %}Cuota de socio de {{ club.nombre }}: clases por nivel, partidos, torneos y comunidad en una sola cuota mensual. {{ club.ubicacion.zona }}.{% endblock %}
{% block main %}
{% set P = club.precios %}
{% set TP = T.precios %}
{% macro clp(n) %}${{ "{:,}".format(n).replace(",", ".") }}{% endmacro %}
{% macro check() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% endmacro %}
{% macro tag(n, label, extra="") %}<p class="eyebrow eyebrow--{{ E.etiquetas }} {{ extra }}">{% if E.etiquetas == "barra" %}<b>/{{ n }}</b> {% elif E.etiquetas == "numero" %}<b>{{ n }}</b> {% endif %}{{ label }}</p>{% endmacro %}
<main id="main" class="page">

<!-- =========================================================
     CUOTA DE SOCIO
     ========================================================= -->
<section class="section" style="padding-top:0" aria-labelledby="pricing-title">
  <div class="wrap pricing">
    <div>
      {{ tag("$", TP.etiqueta, "reveal") }}
      <h1 class="reveal" id="pricing-title">{{ TP.titulo }}</h1>
      <p class="lead reveal" data-delay="1">{{ TP.bajada }}</p>
      <div class="perks reveal" data-delay="2">
{% for g in TP.incluye %}
        <div>
          <h2>{{ g.titulo }}</h2>
          <ul>
{% for it in g["items"] %}
            <li>{{ check() }}{{ it }}</li>
{% endfor %}
          </ul>
        </div>
{% endfor %}
      </div>
    </div>

    <aside class="price-card reveal" data-delay="1" aria-labelledby="price-label">
{% set first = P.grupos[0] %}
      <p class="price-card__label" id="price-label">{{ TP.tarjeta }}</p>
      <p class="price" aria-live="polite"><strong class="js-price">{{ clp(P.mensual[first]) }}</strong><span>{{ TP.mes }}</span></p>
      <p class="price-note js-price-note">{{ TP.nota_mensual }}</p>
      <fieldset class="group">
        <legend>{{ TP.son }}</legend>
        <div class="seg">
{% for g in P.grupos %}
          <label><input type="radio" name="size" value="{{ g }}"{% if loop.first %} checked{% endif %}><span>{{ g }}</span></label>
{% endfor %}
        </div>
        <span class="group__after">{{ TP.en_clase }}</span>
      </fieldset>
{% if P.anual %}
      <label class="toggle">
        <input type="checkbox" class="js-annual" role="switch">
        <span><b>{{ TP.anual_titulo }}</b><small>{{ TP.anual_texto }}</small></span>
      </label>
{% endif %}
      <a class="btn btn--solid js-wa js-price-cta" data-wa="precios" href="#">{{ m.wa_icon() }}{{ TP.boton }}</a>
      <p class="price-card__limit">{{ TP.limite }}</p>
{% if P.individual %}
      <p class="price-card__alt">{{ TP.individual | replace("{individual}", clp(P.individual)) }}</p>
{% endif %}
      {{ m.sample(P.muestra) }}
    </aside>
  </div>
</section>

<!-- =========================================================
     TU PRIMER DÍA
     ========================================================= -->
<section class="section section--alt" aria-labelledby="first-title">
  <div class="wrap">
    {{ tag("01", TP.primer_dia.etiqueta, "reveal") }}
    <h2 class="h2 reveal" id="first-title">{{ TP.primer_dia.titulo }}</h2>
    <ol class="cards cards--3">
{% for c in TP.primer_dia["items"] %}
      <li class="card reveal"{% if loop.index0 %} data-delay="{{ loop.index0 }}"{% endif %}><span class="card__n" aria-hidden="true">{{ "%02d" % loop.index }}</span><h3>{{ c.titulo }}</h3><p>{{ c.texto }}</p></li>
{% endfor %}
    </ol>
  </div>
</section>

<!-- =========================================================
     LA SESIÓN
     ========================================================= -->
<section class="section" aria-labelledby="session-title">
  <div class="wrap">
    {{ tag("02", TP.sesion.etiqueta, "reveal") }}
    <h2 class="h2 reveal" id="session-title">{{ TP.sesion.titulo }}</h2>
    <ol class="cards cards--4">
{% for c in TP.sesion["items"] %}
      <li class="card reveal"{% if loop.index0 %} data-delay="{{ loop.index0 }}"{% endif %}><div class="card__top"><h3>{{ c.titulo }}</h3><span class="card__pct">{{ c.pct }}</span></div><p>{{ c.texto }}</p></li>
{% endfor %}
    </ol>
  </div>
</section>

<!-- =========================================================
     NIVELES
     ========================================================= -->
<section class="section section--alt" aria-labelledby="levels-title">
  <div class="wrap">
    {{ tag("03", TP.niveles.etiqueta, "reveal") }}
    <h2 class="h2 reveal" id="levels-title">{{ TP.niveles.titulo }}</h2>
    <div class="levels-table reveal" data-delay="1">
      <table>
        <thead><tr>{% for c in TP.niveles.columnas %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{% for f in TP.niveles.filas %}
          <tr>{% for c in f %}<td>{{ c }}</td>{% endfor %}</tr>
{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- =========================================================
     GARANTÍAS
     ========================================================= -->
{% set icons = [
  '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  '<circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.9 3.1-7 7-7 1.6 0 3 .5 4.2 1.4"/><path d="M15 18l2 2 4-4"/>'] %}
<section class="section" aria-labelledby="promise-title">
  <div class="wrap">
    {{ tag("04", TP.garantias.etiqueta, "reveal") }}
    <h2 class="h2 reveal" id="promise-title">{{ TP.garantias.titulo }}</h2>
    <ul class="cards cards--3">
{% for c in TP.garantias["items"] %}
      <li class="card reveal"{% if loop.index0 %} data-delay="{{ loop.index0 }}"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">{{ icons[loop.index0 % 3] }}</svg><h3>{{ c.titulo }}</h3><p>{{ c.texto }}</p></li>
{% endfor %}
    </ul>
{% if club.metodo.muestra %}
    <p class="reveal" style="margin-top:20px">{{ m.sample("Contenido de ejemplo · confirmar método y condiciones") }}</p>
{% endif %}
  </div>
</section>

<!-- =========================================================
     CIERRE
     ========================================================= -->
<section class="section section--alt closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 class="h2 reveal" id="closing-title">{{ TP.cierre.titulo }}</h2>
    <p class="reveal" data-delay="1">{{ TP.cierre.texto }}</p>
    <a class="btn btn--solid js-wa reveal" data-wa="primera-sesion" data-delay="2" href="#">{{ m.wa_icon() }}{{ TP.boton }}</a>
    <small class="reveal" data-delay="2">{{ TP.cierre.nota }}</small>
  </div>
</section>

</main>
{% endblock %}
