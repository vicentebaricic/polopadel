/* =========================================================
   TOKENS — generados desde club.yml (paleta, tipografía, forma)
   ========================================================= */
:root{
  --font-display: {{ tipo.titulos }};
  --font: {{ tipo.texto }};
  --font-mono: {{ tipo.mono }};
  --display-weight: {{ tipo.peso }};
  --display-stretch: {{ tipo.ancho }};
  --display-case: {{ tipo.mayusculas }};
  --display-tracking: {{ tipo.tracking }};

{% for k, v in tok.base.items() %}
  --{{ k }}: {{ v }};
{% endfor %}

{% for k, v in tok.clara.items() %}
  --{{ k }}: {{ v }};
{% endfor %}
  --accent: var(--ball);
  --on-accent: var(--navy);

  --fs-eyebrow: .75rem;
  --fs-body: 1rem;
  --fs-lead: clamp(1.0625rem, 1.6vw, 1.25rem);
  --fs-h3: {{ fs.h3 }};
  --fs-h2: {{ fs.h2 }};
  --fs-h1: {{ fs.h1 }};

  --gutter: clamp(16px, 4vw, 56px);
  --maxw: 1320px;
  --section: clamp(72px, 10vw, 140px);
  --radius: {{ forma.radio }};
  --radius-lg: {{ forma.radio_grande }};
  --radius-pill: {{ forma.boton }};

  --ease: cubic-bezier(.22,.61,.36,1);
  --ease-out: cubic-bezier(.16,1,.3,1);
  --dur: .25s;
  --dur-reveal: .9s;

  --header-h: 72px;
}
/* Propuesta de marca (domina el color principal) */
:root[data-palette="marca"]{
{% for k, v in tok.marca.items() %}
  --{{ k }}: {{ v }};
{% endfor %}
}
/* Variantes oscuras */
:root[data-theme="dark"]{ {% for k, v in tok.clara_oscura.items() %}--{{ k }}: {{ v }}; {% endfor %}}
:root[data-palette="marca"][data-theme="dark"]{ {% for k, v in tok.marca_oscura.items() %}--{{ k }}: {{ v }}; {% endfor %}}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ {% for k, v in tok.clara_oscura.items() %}--{{ k }}: {{ v }}; {% endfor %}}
  :root[data-palette="marca"]:not([data-theme="light"]){ {% for k, v in tok.marca_oscura.items() %}--{{ k }}: {{ v }}; {% endfor %}}
}

/* =========================================================
   BASE
   ========================================================= */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 8px);-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:var(--font);font-size:var(--fs-body);line-height:1.65;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  transition:background-color var(--dur) var(--ease), color var(--dur) var(--ease);
}
body.no-scroll{overflow:hidden}
img,video{display:block;max-width:100%}
a{color:inherit}
button{font:inherit;color:inherit}
h1,h2,h3{margin:0;font-family:var(--font-display);font-stretch:var(--display-stretch);font-weight:var(--display-weight);line-height:.98;letter-spacing:var(--display-tracking);text-transform:var(--display-case);text-wrap:balance}
p{margin:0}
:focus-visible{outline:2px solid var(--focus);outline-offset:3px;border-radius:4px}
.skip{position:absolute;left:12px;top:-60px;z-index:1000;background:var(--btn-bg);color:var(--btn-text);padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:600}
.skip:focus{top:12px}
.visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.wrap{width:100%;max-width:var(--maxw);margin-inline:auto;padding-inline:var(--gutter)}
.section{padding-block:var(--section)}
.section--alt{background:var(--bg-alt)}
.club > *,.system > *,.visit > *,.belief__in > *{min-width:0}

/* Etiqueta tipo "/01 EL CLUB" */
.eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--font-mono);font-size:var(--fs-eyebrow);letter-spacing:.2em;text-transform:uppercase;color:var(--text-3);margin-bottom:22px}
.eyebrow b{font-weight:500;color:var(--tone)}
.h2{font-size:var(--fs-h2)}
.h2 em{font-style:italic;color:var(--hl)}
.lead{font-size:var(--fs-lead);color:var(--text-2);max-width:60ch}
.lead strong{color:var(--text);font-weight:600}

/* Contenido de ejemplo: reemplazar antes de publicar */
.sample{
  display:inline-flex;align-items:center;gap:6px;vertical-align:middle;
  font-family:var(--font-mono);font-size:.625rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;line-height:1;
  padding:5px 8px;border-radius:6px;border:1px dashed currentColor;color:var(--tone);background:transparent;line-height:1.3;
}
.sample::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.sample--dark{color:#F1C9A8}

/* Botones */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 24px;
  border-radius:var(--radius-pill);border:1.5px solid transparent;cursor:pointer;
  font-family:var(--font-display);font-stretch:110%;font-weight:700;font-size:.875rem;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;
  transition:transform var(--dur) var(--ease), background-color var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  touch-action:manipulation;white-space:nowrap;
}
.btn svg{width:18px;height:18px;flex:none}
.btn:active{transform:scale(.97)}
.btn--solid{background:var(--btn-bg);color:var(--btn-text)}
.btn--solid:hover{filter:brightness(1.06)}
.btn--ball{background:var(--ball);color:var(--navy)}
.btn--ball:hover{filter:brightness(1.08)}
.btn--ghost{border-color:currentColor;background:transparent}
.btn--ghost:hover{background:var(--text);color:var(--bg)}
.btn--ghost-light{border-color:rgba(255,255,255,.7);color:#fff}
.btn--ghost-light:hover{background:#fff;color:var(--navy)}
.link-arrow{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-display);font-stretch:110%;font-weight:700;font-size:.875rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--hl);padding-block:12px}
.link-arrow svg{width:18px;height:18px;transition:transform var(--dur) var(--ease)}
.link-arrow:hover svg{transform:translateX(4px)}

/* Marcador cuando falta una foto o video */
.media{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--placeholder-a),var(--placeholder-b))}
.media > img,.media > video{width:100%;height:100%;object-fit:cover}
.media.is-missing > img,.media.is-missing > video{visibility:hidden}
.media.is-missing::after{
  content:attr(data-file);position:absolute;inset:auto 12px 12px 12px;
  font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.04em;color:var(--text-3);
}

/* =========================================================
   HEADER
   ========================================================= */
.header{
  position:fixed;inset:0 0 auto 0;z-index:100;height:var(--header-h);
  transition:background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  border-bottom:1px solid transparent;color:var(--text);background:var(--header-bg);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
}
.header.is-over{background:transparent;color:#fff;-webkit-backdrop-filter:none;backdrop-filter:none}
.header.is-over .btn--solid{background:var(--ball);color:var(--navy)}
.header.is-scrolled{border-bottom-color:var(--line)}
.header__in{height:100%;display:flex;align-items:center;gap:24px}
.brand{display:flex;align-items:center;text-decoration:none;flex:none}
.brand{color:var(--logo)}
.brand__logo{display:block;height:44px;aspect-ratio:{{ club.marca.logo_ancho }}/{{ club.marca.logo_alto }};background:currentColor;
  -webkit-mask:url("{{ club.marca.logo }}") center/contain no-repeat;mask:url("{{ club.marca.logo }}") center/contain no-repeat;
  transition:background-color var(--dur) var(--ease)}
.header.is-over .brand{color:#fff}
.nav{display:none;margin-left:auto}
.nav ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav a{font-family:var(--font-display);font-stretch:105%;font-weight:600;font-size:.8125rem;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;padding:12px 0;position:relative}
.nav a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;background:var(--ball);transform:scaleX(0);transform-origin:left;transition:transform var(--dur) var(--ease)}
.nav a:hover::after{transform:scaleX(1)}
.header__actions{display:flex;align-items:center;gap:8px;margin-left:auto}
.nav + .header__actions{margin-left:24px}
.header__actions .btn{min-height:44px;padding:0 18px;font-size:.75rem}
.header__book{display:none}
.icon-btn{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;border:0;background:transparent;cursor:pointer}
.icon-btn svg{width:20px;height:20px}
.icon-btn:hover{background:rgba(127,127,127,.15)}
.theme-toggle .i-sun{display:none}
:root[data-theme="dark"] .theme-toggle .i-sun{display:block}
:root[data-theme="dark"] .theme-toggle .i-moon{display:none}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]) .theme-toggle .i-sun{display:block}
  :root:not([data-theme="light"]) .theme-toggle .i-moon{display:none}
}
@media (min-width: 1024px){
  .nav{display:block}
  .menu-toggle{display:none}
  .header__book{display:inline-flex}
}

/* Menú móvil */
.drawer{
  position:fixed;inset:var(--header-h) 0 0 0;z-index:99;background:var(--bg);
  padding:24px var(--gutter) 40px;display:flex;flex-direction:column;gap:28px;overflow:auto;
  opacity:0;visibility:hidden;transform:translateY(-8px);
  transition:opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility 0s linear var(--dur);
}
.drawer.is-open{opacity:1;visibility:visible;transform:none;transition-delay:0s}
.drawer ul{list-style:none;margin:0;padding:0}
.drawer li + li{border-top:1px solid var(--line)}
.drawer ul a{display:flex;justify-content:space-between;align-items:center;padding:18px 0;text-decoration:none;font-family:var(--font-display);font-stretch:112%;font-weight:800;font-size:1.5rem;text-transform:uppercase}
.drawer ul a span{font-family:var(--font-mono);font-size:.75rem;font-weight:500;color:var(--tone)}
.drawer .btn{width:100%}

/* =========================================================
   HERO
   ========================================================= */
.hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;color:#fff;background:var(--navy-deep);overflow:hidden}
.hero__media{position:absolute;inset:0;background:var(--navy-deep)}
.hero__media img,.hero__media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.hero__media img,.hero__media video{object-position:50% 35%}
.hero.no-video .hero__media video,.hero.no-video .hero__pause{display:none}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,color-mix(in srgb,var(--navy-deep) 55%,transparent) 0%,color-mix(in srgb,var(--navy-deep) 10%,transparent) 35%,color-mix(in srgb,var(--navy-deep) 82%,transparent) 100%);pointer-events:none}
.hero__in{position:relative;z-index:1;padding-top:calc(var(--header-h) + 48px);padding-bottom:clamp(40px,7vw,88px)}
.hero h1{font-size:var(--fs-h1);font-stretch:118%;max-width:12ch}
.hero h1 em{font-style:italic;color:var(--ball)}
.hero__sub{margin-top:20px;font-size:var(--fs-lead);max-width:44ch;color:rgba(255,255,255,.86)}
.hero__ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.hero__ctas .btn{flex:1 1 220px}
.hero__stat{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:36px;padding-top:24px;border-top:1px solid rgba(255,255,255,.2)}
.hero__stat strong{font-family:var(--font-display);font-stretch:118%;font-weight:900;font-size:clamp(2rem,5vw,2.75rem);line-height:1;color:var(--ball)}
.hero__stat span{font-size:.9375rem;line-height:1.4;color:rgba(255,255,255,.86)}
.hero__pause{position:absolute;z-index:2;right:var(--gutter);top:calc(var(--header-h) + 16px);color:#fff;border:1px solid rgba(255,255,255,.35)}
.hero__pause .i-play{display:none}
.hero__pause[aria-pressed="true"] .i-play{display:block}
.hero__pause[aria-pressed="true"] .i-pause{display:none}
@media (min-width: 768px){
  .hero__ctas .btn{flex:0 0 auto}
}

/* =========================================================
   EL CLUB · Entrena / Conecta / Compite
   ========================================================= */
.club{display:grid;gap:48px}
.club__text .lead + .lead{margin-top:18px}
.club__text .lead--strong{color:var(--text);font-weight:500}
.club__links{display:flex;flex-wrap:wrap;gap:8px 32px;margin-top:28px}

.feats{display:flex;flex-direction:column;gap:8px}
.feat{
  position:relative;border-radius:var(--radius);overflow:hidden;background:var(--navy);
  flex:0 0 64px;transition:flex-basis .7s var(--ease-out);
}
.feat.is-active{flex-basis:min(118vw,520px)}
.feat__media{position:absolute;inset:0}
.feat__media.media{background:linear-gradient(160deg,var(--brand),var(--navy) 70%)}
.feat__media::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,transparent 55%,color-mix(in srgb,var(--navy-deep) 55%,transparent));pointer-events:none}
.feat:not(.is-active) .feat__media{opacity:.35}
.feat__media.is-missing::after{z-index:2;color:rgba(255,255,255,.65)}
.feat__tab{
  position:absolute;inset:0;z-index:3;width:100%;border:0;background:transparent;cursor:pointer;
  display:flex;align-items:center;gap:14px;padding:0 20px;text-align:left;color:#fff;
}
.feat.is-active .feat__tab{cursor:default}
.feat__num{font-family:var(--font-mono);font-size:.75rem;color:var(--ball)}
.feat__label{font-family:var(--font-display);font-stretch:118%;font-weight:800;font-size:1.0625rem;letter-spacing:.14em;text-transform:uppercase;transition:opacity var(--dur) var(--ease)}
.feat.is-active .feat__label,.feat.is-active .feat__num{opacity:0}
.feat__bar{position:absolute;z-index:4;left:16px;right:16px;bottom:14px;height:3px;border-radius:3px;background:rgba(255,255,255,.25);overflow:hidden;opacity:0;transition:opacity var(--dur) var(--ease)}
.feat.is-active .feat__bar{opacity:1}
.feat__bar i{display:block;height:100%;width:100%;background:var(--ball);transform-origin:left;transform:scaleX(var(--p,0))}

.feat-caption{margin-top:22px;min-height:96px}
.feat-caption h3{font-size:var(--fs-h3);font-stretch:118%}
.feat-caption h3 i{font-style:normal;color:var(--ball)}
.feat-caption p{margin-top:8px;color:var(--text-2)}
.feat-caption.is-swapping{animation:fadeUp .5s var(--ease-out)}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.feat-controls{display:flex;align-items:center;gap:12px;margin-top:16px}
.feat-controls .icon-btn{border:1px solid var(--line)}
.feat-controls .i-play{display:none}
.feat-controls [aria-pressed="true"] .i-play{display:block}
.feat-controls [aria-pressed="true"] .i-pause{display:none}
.feat-dots{display:flex;gap:8px}
.feat-dots button{width:44px;height:44px;border:0;background:transparent;cursor:pointer;display:grid;place-items:center;padding:0}
.feat-dots button::before{content:"";width:26px;height:4px;border-radius:4px;background:var(--line);transition:background-color var(--dur) var(--ease)}
.feat-dots button[aria-current="true"]::before{background:var(--hl)}

@media (min-width: 640px){
  .feats{flex-direction:row;height:clamp(380px,46vw,500px)}
  .feat{flex:0 0 72px}
  .feat.is-active{flex:1 1 auto}
  .feat__tab{flex-direction:column;justify-content:space-between;padding:26px 0 24px}
  .feat__label{writing-mode:vertical-rl;transform:rotate(180deg);font-size:1.125rem;letter-spacing:.18em}
  .feat__tab::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--ball)}
  .feat.is-active .feat__tab::after{opacity:0}
}
@media (min-width: 1024px){
  .club{grid-template-columns:1.05fr 1fr;gap:clamp(48px,6vw,96px);align-items:start}
  .club .h2{font-size:clamp(2.25rem,3.8vw,3.5rem)}
}

/* =========================================================
   PARTNERS
   ========================================================= */
.partners{padding-block:44px;border-block:1px solid var(--line);overflow:hidden}
.partners__head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:24px}
.partners__head .eyebrow{margin:0}
.marquee{display:flex;width:max-content;animation:marquee 40s linear infinite}
.marquee:hover{animation-play-state:paused}
.marquee ul{display:flex;align-items:center;gap:clamp(40px,6vw,88px);list-style:none;margin:0;padding:0 clamp(20px,3vw,44px)}
.partner{height:44px;display:flex;align-items:center}
.partner img{height:44px;width:auto;max-width:170px;object-fit:contain;filter:var(--partner-filter)}
.partner.is-missing img{display:none}
.partner--wide img{height:30px}
.partner__name{display:none;font-family:var(--font-display);font-stretch:125%;font-weight:800;font-size:1.25rem;letter-spacing:.06em;text-transform:uppercase;color:var(--text-3);opacity:.75;white-space:nowrap}
.partner.is-missing .partner__name{display:block}
@keyframes marquee{to{transform:translateX(-50%)}}

/* =========================================================
   POLO SYSTEM
   ========================================================= */
.system{display:grid;gap:48px}
.system__intro .lead{margin-top:22px}
.system__intro .btn{margin-top:32px}
.system__photo{margin:40px 0 0;aspect-ratio:4/3;border-radius:var(--radius)}
.steps{list-style:none;margin:0;padding:0;counter-reset:step}
.step{display:grid;grid-template-columns:auto 1fr;gap:6px 22px;padding:28px 0;border-top:1px solid var(--line)}
.step:last-child{border-bottom:1px solid var(--line)}
.step__n{grid-row:span 2;font-family:var(--font-display);font-stretch:125%;font-weight:900;font-size:clamp(2.75rem,6vw,4rem);line-height:.85;color:transparent;-webkit-text-stroke:1.5px var(--tone)}
.step h3{font-size:var(--fs-h3);font-stretch:118%}
.step h3 small{display:block;margin-top:8px;font-family:var(--font-mono);font-size:.6875rem;font-weight:500;letter-spacing:.16em;color:var(--hl)}
.step p{color:var(--text-2);max-width:52ch}
.levels{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.levels li{list-style:none;padding:8px 14px;border-radius:var(--radius-pill);border:1px solid var(--line);font-family:var(--font-mono);font-size:.75rem;letter-spacing:.06em}
.levels li b{color:var(--hl);font-weight:500}
.levels{padding:0}
@media (min-width: 1024px){
  .system{grid-template-columns:.9fr 1.1fr;gap:clamp(48px,7vw,120px)}
  .system__intro{position:sticky;top:calc(var(--header-h) + 40px);align-self:start}
}

/* =========================================================
   CONVICCIÓN · Garantía
   ========================================================= */
.belief{position:relative;overflow:hidden;color:var(--navy);background:var(--wood)}
.belief__media{position:absolute;inset:0}
.belief__media.media{background:linear-gradient(135deg,var(--wood),var(--earth))}
.belief__media video{object-position:60% 50%}
.belief__media.is-missing::after{color:color-mix(in srgb,var(--navy) 55%,transparent);inset:auto var(--gutter) 20px auto}
/* Degradado suave solo detrás del texto: el video se ve con sus colores */
.belief::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--wood) 62%,transparent) 0%,color-mix(in srgb,var(--wood) 32%,transparent) 45%,transparent 72%);pointer-events:none;z-index:1}
.belief__in{position:relative;z-index:2;padding-block:clamp(56px,7vw,96px);display:grid;gap:36px;align-items:center}
.belief .eyebrow{color:color-mix(in srgb,var(--navy) 80%,transparent);padding-bottom:16px;border-bottom:1px solid color-mix(in srgb,var(--navy) 25%,transparent);margin-bottom:28px}
.belief .eyebrow b{color:var(--navy)}
.belief h2{font-size:clamp(2rem,4.4vw,3.5rem);max-width:16ch}
.belief p:not(.eyebrow){margin-top:20px;font-size:var(--fs-lead);font-weight:500;max-width:46ch}
.belief p strong{color:#fff;font-weight:600}
.belief .btn{margin-top:24px}
.belief .sample{color:var(--navy)}
.seal{width:min(44vw,230px);aspect-ratio:1;justify-self:center;position:relative;color:var(--navy)}
.seal svg{width:100%;height:100%}
.seal__ring{transform-origin:50% 50%;animation:spin 30s linear infinite}
.seal__core{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.seal__core strong{font-family:var(--font-display);font-stretch:118%;font-weight:900;font-size:clamp(3.5rem,10vw,5rem);line-height:.9}
.seal__core span{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.28em;margin-top:8px}
@keyframes spin{to{transform:rotate(360deg)}}
@media (min-width: 1024px){
  .belief__in{grid-template-columns:1.5fr 1fr}
  .seal{justify-self:end}
}

/* =========================================================
   EQUIPO
   ========================================================= */
.section-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 40px;margin-bottom:clamp(40px,5vw,64px)}
.section-head .lead{max-width:44ch}
.team{display:grid;gap:28px 20px;grid-template-columns:1fr;list-style:none;margin:0;padding:0}
.member__photo{aspect-ratio:4/5;border-radius:var(--radius)}
/* Fotos del equipo: mismo tratamiento para todas (gris con tono azul), a color al pasar el mouse */
.member__photo img{filter:grayscale(1) contrast(1.06);transition:filter .6s var(--ease), transform .8s var(--ease-out)}
.member__photo::before{content:"";position:absolute;inset:0;z-index:1;background:var(--brand);mix-blend-mode:soft-light;opacity:.55;pointer-events:none;transition:opacity .6s var(--ease)}
.member__photo.is-missing::before{content:none}
@media (hover:hover){
  .member:hover .member__photo img{filter:none;transform:scale(1.03)}
  .member:hover .member__photo::before{opacity:0}
}
.member__photo .initials{position:absolute;inset:0;display:none;place-items:center;font-family:var(--font-display);font-stretch:125%;font-weight:900;font-size:3.5rem;color:var(--text-3);opacity:.6}
.member__photo.is-missing .initials{display:grid}
.member__photo.is-missing::after{content:none}
.member h3{margin-top:18px;font-size:1.375rem;font-stretch:115%}
.member__role{margin-top:6px;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--hl)}
.member p{margin-top:10px;color:var(--text-2);font-size:.9375rem}
@media (min-width: 560px){ .team{grid-template-columns:repeat(2,1fr)} }
@media (min-width: 1024px){ .team{grid-template-columns:repeat(4,1fr)} }

/* =========================================================
   RESEÑAS
   ========================================================= */
.rating{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.rating strong{font-family:var(--font-display);font-stretch:118%;font-weight:900;font-size:3rem;line-height:1}
.stars{display:inline-flex;gap:2px;color:var(--ball)}
:root:not([data-palette="marca"]):not([data-theme="dark"]) .stars{color:#E0A100}
@media (prefers-color-scheme: dark){ :root:not([data-palette="marca"]):not([data-theme="light"]) .stars{color:var(--ball)} }
.stars svg{width:18px;height:18px}
.rating small{display:block;color:var(--text-3);font-size:.875rem}
.reviews{display:grid;gap:16px;grid-template-columns:1fr;list-style:none;margin:0;padding:0}
.review{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:28px;display:flex;flex-direction:column;gap:18px}
.review blockquote{margin:0;font-size:1.0625rem;line-height:1.6}
.review footer{margin-top:auto;display:flex;align-items:center;gap:12px;font-size:.875rem;color:var(--text-3)}
.review footer b{display:block;color:var(--text);font-weight:600}
.avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--surface-2);font-weight:600;color:var(--text)}
.reviews__more{margin-top:28px}
@media (min-width: 768px){ .reviews{grid-template-columns:repeat(3,1fr)} }

.band{height:clamp(240px,42vw,560px)}

/* =========================================================
   HORARIOS + UBICACIÓN
   ========================================================= */
.visit{display:grid;gap:48px}
.hours{list-style:none;margin:28px 0 0;padding:0}
.hours li{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
.hours li span:first-child{font-weight:500}
.hours li span:last-child{color:var(--text-2)}
.hours li.is-today{position:relative}
.hours li.is-today span{color:var(--text);font-weight:600}
.hours li.is-today span:first-child::after{content:"Hoy";margin-left:10px;padding:3px 8px;border-radius:6px;background:var(--ball);color:var(--navy);font-family:var(--font-mono);font-size:.625rem;letter-spacing:.1em;text-transform:uppercase;vertical-align:2px}
.hours-note{margin-top:14px;font-size:.875rem;color:var(--text-3)}
.address{margin-top:28px;font-size:1.125rem;font-style:normal;line-height:1.5}
.address small{display:block;color:var(--text-3);font-size:.9375rem}
.visit__ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.map{border-radius:var(--radius);overflow:hidden;min-height:360px;background:var(--surface);border:1px solid var(--line)}
.map iframe{width:100%;height:100%;min-height:360px;border:0;display:block}
:root[data-theme="dark"] .map iframe,
:root[data-palette="marca"] .map iframe{filter:grayscale(.4) invert(.9) hue-rotate(180deg) contrast(.9)}
:root[data-palette="marca"][data-theme="light"] .map iframe{filter:none}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .map iframe{filter:grayscale(.4) invert(.9) hue-rotate(180deg) contrast(.9)} }
@media (min-width: 1024px){
  .visit{grid-template-columns:1fr 1.2fr;gap:clamp(48px,6vw,96px);align-items:stretch}
}

/* =========================================================
   CTA FINAL + FOOTER
   ========================================================= */
.cta{background:var(--ball);color:var(--navy);text-align:center}
.cta h2{font-size:clamp(2.25rem,7vw,5.5rem);font-stretch:120%;max-width:14ch;margin-inline:auto}
.cta h2 em{font-style:italic}
.cta p{margin:20px auto 0;max-width:46ch;font-size:var(--fs-lead)}
.cta__btns{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:32px}
.cta .btn--solid{background:var(--navy);color:#fff}
.cta .btn--ghost{color:var(--navy)}
.cta .btn--ghost:hover{background:var(--navy);color:#fff}

.footer{padding-block:64px 40px;background:var(--navy-deep);color:color-mix(in srgb,#fff 88%,var(--navy-deep))}
.footer__grid{display:grid;gap:40px}
.footer .brand{color:#fff}
.footer__tag{margin-top:16px;color:color-mix(in srgb,#fff 68%,var(--navy-deep));max-width:34ch}
.footer h4{margin:0 0 14px;font-family:var(--font-mono);font-size:.6875rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in srgb,#fff 55%,var(--navy-deep))}
.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.footer ul a{display:inline-flex;align-items:center;gap:10px;padding:6px 0;text-decoration:none}
.footer ul a:hover{color:var(--ball)}
.footer ul svg{width:18px;height:18px}
.footer__base{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:56px;padding-top:24px;border-top:1px solid rgba(255,255,255,.12);font-size:.8125rem;color:color-mix(in srgb,#fff 55%,var(--navy-deep))}
@media (min-width: 768px){ .footer__grid{grid-template-columns:1.4fr 1fr 1fr 1fr} }

/* WhatsApp flotante */
.wa-float{
  position:fixed;right:16px;bottom:16px;z-index:90;width:56px;height:56px;border-radius:50%;
  display:grid;place-items:center;background:#25D366;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.25);
  opacity:0;transform:translateY(16px) scale(.9);pointer-events:none;
  transition:opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
}
.wa-float svg{width:28px;height:28px}
.wa-float.is-visible{opacity:1;transform:none;pointer-events:auto}

/* Selector de propuesta (solo para revisar — quitar antes de publicar) */
.palette-switch{
  position:fixed;left:16px;bottom:16px;z-index:90;display:flex;gap:4px;padding:4px;border-radius:var(--radius-pill);
  background:color-mix(in srgb,var(--navy-deep) 92%,transparent);color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.25);font-size:.75rem;
}
.palette-switch span{align-self:center;padding:0 8px 0 10px;font-family:var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:color-mix(in srgb,#fff 68%,var(--navy-deep))}
.palette-switch button{min-height:36px;padding:0 14px;border-radius:var(--radius-pill);border:0;background:transparent;cursor:pointer;font-weight:600}
.palette-switch button[aria-pressed="true"]{background:var(--ball);color:var(--navy)}
@media (max-width: 420px){ .palette-switch span{display:none} }

/* =========================================================
   ANIMACIONES DE ENTRADA
   ========================================================= */
.reveal{opacity:0;transform:translateY(24px);transition:opacity var(--dur-reveal) var(--ease-out), transform var(--dur-reveal) var(--ease-out)}
.reveal[data-delay="1"]{transition-delay:.08s}
.reveal[data-delay="2"]{transition-delay:.16s}
.reveal[data-delay="3"]{transition-delay:.24s}
.reveal.is-in{opacity:1;transform:none}
.no-js .reveal{opacity:1;transform:none}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .marquee{animation:none;flex-wrap:wrap;width:auto;justify-content:center}
  .marquee ul[aria-hidden="true"]{display:none}
  .marquee ul{flex-wrap:wrap;justify-content:center;row-gap:24px}
  .reveal{opacity:1;transform:none}
}

/* =========================================================
   PÁGINA DE PRECIOS
   ========================================================= */
.page{padding-top:calc(var(--header-h) + clamp(40px,6vw,80px))}
.pricing{display:grid;gap:48px;align-items:start}
.pricing h1{font-size:clamp(2.5rem,6.2vw,4.75rem);font-stretch:116%}
@media (min-width: 1024px){ .pricing h1{font-size:clamp(2.75rem,4.4vw,4.25rem)} }
.pricing h1 em{font-style:italic;color:var(--hl)}
.pricing .lead{margin-top:22px}
.perks{display:grid;gap:36px 40px;margin-top:44px}
.perks h2{font-family:var(--font-mono);font-size:.75rem;font-weight:500;letter-spacing:.2em;color:var(--tone);margin-bottom:14px}
.perks ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.perks li{display:grid;grid-template-columns:20px 1fr;gap:12px;align-items:start;font-size:1.0625rem;line-height:1.45}
.perks li svg{width:18px;height:18px;margin-top:3px;color:var(--hl)}
@media (min-width: 640px){ .perks{grid-template-columns:1fr 1fr} }

.price-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:clamp(24px,3.4vw,40px);position:relative}
.price-card__label{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--tone)}
.price{display:flex;align-items:baseline;gap:10px;margin-top:14px;font-variant-numeric:tabular-nums}
.price strong{font-family:var(--font-display);font-stretch:112%;font-weight:900;font-size:clamp(3.25rem,7vw,4.75rem);line-height:.9}
.price span{font-family:var(--font-display);font-weight:700;font-size:1.25rem;text-transform:uppercase;color:var(--text-2)}
.price-note{margin-top:8px;font-size:.875rem;color:var(--text-3)}
.group{border:0;margin:26px 0 0;padding:0;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.group legend{float:left;margin-right:4px;color:var(--text-2)}
.seg{display:inline-flex;padding:4px;border-radius:var(--radius-pill);border:1px solid var(--line)}
.seg label{position:relative}
.seg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.seg span{display:grid;place-items:center;width:48px;height:44px;border-radius:var(--radius-pill);font-family:var(--font-mono);font-weight:500;transition:background-color var(--dur) var(--ease), color var(--dur) var(--ease)}
.seg input:checked + span{background:var(--btn-bg);color:var(--btn-text)}
.seg input:focus-visible + span{outline:2px solid var(--focus);outline-offset:2px}
.group__after{color:var(--text-2)}
.toggle{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;margin-top:24px;padding:18px;border:1px solid var(--line);border-radius:var(--radius);cursor:pointer}
.toggle input{appearance:none;-webkit-appearance:none;margin:2px 0 0;width:46px;height:26px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);position:relative;cursor:pointer;transition:background-color var(--dur) var(--ease)}
.toggle input::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--text-3);transition:transform var(--dur) var(--ease), background-color var(--dur) var(--ease)}
.toggle input:checked{background:var(--btn-bg)}
.toggle input:checked::after{transform:translateX(20px);background:var(--btn-text)}
.toggle b{display:block;font-family:var(--font-mono);font-weight:500;font-size:.8125rem;letter-spacing:.12em;text-transform:uppercase}
.toggle small{display:block;margin-top:6px;color:var(--text-2);font-size:.9375rem}
.price-card .btn{margin-top:28px;width:100%}
.price-card__limit{margin-top:14px;font-weight:600;color:var(--tone);font-size:.9375rem}
.price-card__alt{margin-top:22px;padding-top:18px;border-top:1px solid var(--line);font-size:.9375rem;color:var(--text-2)}
.price-card__alt strong{color:var(--text)}
.price-card .sample{margin-top:16px}
@media (min-width: 1024px){
  .pricing{grid-template-columns:1.25fr 1fr;gap:clamp(48px,6vw,96px)}
  .price-card{position:sticky;top:calc(var(--header-h) + 24px)}
}

/* Tarjetas del método */
.cards{display:grid;gap:16px;margin-top:clamp(36px,5vw,56px);list-style:none;padding:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:clamp(22px,2.6vw,32px)}
.card__n{font-family:var(--font-display);font-stretch:125%;font-weight:900;font-size:2.5rem;line-height:1;color:transparent;-webkit-text-stroke:1.5px var(--tone)}
.card__top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.card__pct{font-family:var(--font-mono);font-weight:500;color:var(--tone)}
.card h3{font-size:1.375rem;font-stretch:115%;margin-top:14px}
.card__top h3{margin-top:0}
.card p{margin-top:12px;color:var(--text-2)}
.card svg{width:26px;height:26px;color:var(--tone)}
@media (min-width: 768px){ .cards--3{grid-template-columns:repeat(3,1fr)} .cards--4{grid-template-columns:repeat(2,1fr)} }
@media (min-width: 1100px){ .cards--4{grid-template-columns:repeat(4,1fr)} }

/* Tabla de niveles */
.levels-table{margin-top:clamp(36px,5vw,56px);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden}
.levels-table table{width:100%;border-collapse:collapse}
.levels-table th{background:var(--surface);text-align:left;font-family:var(--font-mono);font-weight:500;font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--text-3);padding:18px 20px}
.levels-table td{padding:18px 20px;border-top:1px solid var(--line);vertical-align:top}
.levels-table td:first-child{font-family:var(--font-display);font-stretch:112%;font-weight:800;text-transform:uppercase;white-space:nowrap}
.levels-table td:nth-child(2){font-family:var(--font-mono);color:var(--tone);white-space:nowrap}
.levels-table td:last-child{color:var(--text-2)}
@media (max-width: 640px){
  .levels-table thead{display:none}
  .levels-table tr{display:grid;grid-template-columns:1fr auto;gap:6px 12px;padding:16px 18px;border-top:1px solid var(--line)}
  .levels-table tr:first-child{border-top:0}
  .levels-table td{padding:0;border:0}
  .levels-table td:last-child{grid-column:1 / -1}
}

/* Cierre */
.closing{text-align:center}
.closing h2{font-size:clamp(2.25rem,5.4vw,4rem);max-width:20ch;margin-inline:auto}
.closing p{margin:20px auto 0;max-width:46ch;font-size:var(--fs-lead);color:var(--text-2)}
.closing .btn{margin-top:32px}
.closing small{display:block;margin-top:18px;color:var(--text-3);font-size:.875rem}
.nav a[aria-current="page"]::after{transform:scaleX(1)}

/* =========================================================
   VARIANTES DE DISEÑO (estilo.* en club.yml)
   ========================================================= */
/* Etiquetas: numero "01 — El club" · simple "— El club" */
.eyebrow--numero b::after{content:" —";color:var(--text-3)}
.eyebrow--simple::before{content:"";width:28px;height:2px;background:var(--tone)}

/* Héroe dividido: texto sobre el color de fondo y el video en un recuadro */
.hero--dividido{min-height:auto;align-items:stretch;background:var(--bg);color:var(--text)}
.hero--dividido::after{content:none}
.hero--dividido .hero__grid{position:relative;display:grid;gap:28px;align-items:center;padding-top:calc(var(--header-h) + 28px);padding-bottom:clamp(40px,6vw,72px)}
.hero--dividido .hero__frame{position:relative;border-radius:var(--radius-lg);overflow:hidden;aspect-ratio:4/5;max-height:72svh;background:var(--navy-deep)}
.hero--dividido .hero__frame::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,color-mix(in srgb,var(--navy-deep) 45%,transparent));pointer-events:none}
.hero--dividido .hero__media{position:absolute;inset:0}
.hero--dividido .hero__pause{top:16px;right:16px}
.hero--dividido .hero__in{position:static;padding:0}
.hero--dividido h1 em{color:var(--hl)}
.hero--dividido .hero__sub,.hero--dividido .hero__stat span{color:var(--text-2)}
.hero--dividido .hero__stat{border-top-color:var(--line)}
.hero--dividido .hero__stat strong{color:var(--hl)}
.hero--dividido .eyebrow{color:var(--text-3)!important}
.hero--dividido .eyebrow b{color:var(--tone)!important}
.hero--dividido .btn--ghost-light{border-color:currentColor;color:var(--text)}
.hero--dividido .btn--ghost-light:hover{background:var(--text);color:var(--bg)}
@media (min-width: 1024px){
  .hero--dividido .hero__grid{grid-template-columns:1fr 1fr;min-height:100svh;gap:clamp(40px,5vw,80px)}
  .hero--dividido .hero__frame{aspect-ratio:auto;height:min(78svh,760px);max-height:none}
}
